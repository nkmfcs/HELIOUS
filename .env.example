# Neon (use its pooled connection string in Railway)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Replace these two placeholders with the generated Railway public domain.
BETTER_AUTH_URL=https://your-service.up.railway.app
VITE_PUBLIC_HOSTNAME=your-service.up.railway.app

# Generate a private 32+ byte value. Never commit the real secret.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Standalone production authentication.
VITE_AUTH_ENABLED=true
AUTH_EMAIL_PASSWORD_ENABLED=true
VITE_EMAIL_PASSWORD_ENABLED=true
GROK_AUTH_ENABLED=false
VITE_GROK_AUTH_ENABLED=false
