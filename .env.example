# Neon (в Railway использовать pooled connection string)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Публичный адрес сервиса на Railway (без завершающего слеша)
BETTER_AUTH_URL=https://helious.up.railway.app

# Приватное значение 32+ байта. Настоящий секрет не коммитить.
# Сгенерировать: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Авторизация по email и паролю (сервер и клиентская сборка)
VITE_AUTH_ENABLED=true
AUTH_EMAIL_PASSWORD_ENABLED=true
VITE_EMAIL_PASSWORD_ENABLED=true
